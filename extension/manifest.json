{
  "manifest_version": 3,
  "name": "Gesture Control Bridge",
  "version": "0.2.0",
  "description": "Conecta o Gesture Control ao navegador e ao controle global do Windows.",
  "key": "",
  "permissions": ["tabs", "scripting", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
